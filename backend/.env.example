# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/speed_to_lead

# --- LLM / embeddings ---
LLM_PROVIDER=openai            # openai | groq (chat classifier + answers)
LLM_MODEL=gpt-4.1-mini
GROQ_API_KEY=
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_CHUNKER_MODEL=gpt-4.1
RAG_REPORT_MODEL=gpt-4.1
CHROMA_COLLECTION=mdcold_kb
TAVILY_API_KEY=

# --- Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=speed-to-lead

# --- Business ---
BUSINESS_NAME=MD Cold Services
BUSINESS_PHONE=(786) 797-6193
BUSINESS_TZ=America/New_York
BUSINESS_INBOX=mdcoldservices@gmail.com

# --- Behaviour ---
SLOT_OFFER_COUNT=3
MIN_LEAD_HOURS=2
REMINDER_HOUR=18
LATE_CHANGE_HOURS=2
KB_TOP_K=6
KB_MAX_PER_SOURCE=2
KB_MIN_SCORE=0.20
WIDGET_ALLOWED_ORIGINS=http://localhost:8000

# --- Email agent (Run B) ---
EMAIL_POLL_ENABLED=false       # true: the app polls the inbox and replies
EMAIL_POLL_SECONDS=90
# New conversations come only from mail sent TO this address (or a form sender below); replies in a
# case's thread are always taken. With a personal Gmail, use a plus address, e.g. you+hvac@gmail.com.
EMAIL_AGENT_ADDRESS=
EMAIL_FORM_SENDERS=            # comma-separated website enquiry-form sender addresses
MAX_AI_REPLIES_PER_THREAD_PER_HOUR=5
# EMAIL_POLL_QUERY=in:inbox -from:me newer_than:3d -category:promotions -category:social -category:updates -category:forums

# --- Google OAuth (Gmail send) ---
# OAuth "Web application" client; add GOOGLE_REDIRECT_URI to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- MCP servers (Klavis Strata) ---
KLAVIS_GMAIL_MCP_URL=
KLAVIS_SLACK_MCP_URL=
KLAVIS_MCP_TOKEN=
GMAIL_SEND_TOOL=gmail_send_email
GMAIL_SEARCH_TOOL=gmail_search_emails
GMAIL_READ_TOOL=gmail_read_email
GMAIL_MODIFY_TOOL=gmail_modify_email
SLACK_POST_TOOL=slack_user_post_message
SLACK_LIST_CHANNELS_TOOL=slack_user_list_channels

# --- Slack app (status channel reads need a real app, not a webhook) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOOKINGS_CHANNEL=        # name or ID; empty -> uses SLACK_URGENT_CHANNEL
SLACK_STATUS_CHANNEL=
SLACK_URGENT_CHANNEL=slack_urgent_channel

# --- Composio (Calendly) ---
COMPOSIO_USER_ID=
COMPOSIO_API_KEY=

# --- WhatsApp Cloud API (phase 2) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
